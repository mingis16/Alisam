# ── Copy to .env.local for development. NEVER commit the real .env.local. ──
# All secrets stay server-side; only NEXT_PUBLIC_* values reach the browser bundle.
#
# This site has no backend/database — booking and contact both hand off to
# WhatsApp client-side, so there's nothing to configure beyond the values below.

# --- App ---
NEXT_PUBLIC_SITE_URL="https://alisamguesthouse.com"
NEXT_PUBLIC_MAPS_EMBED_SRC="https://www.google.com/maps?q=Rotifunk,+Lungi,+Sierra+Leone&output=embed"
NEXT_PUBLIC_WHATSAPP_NUMBER="23276726597"

# --- Analytics ---
NEXT_PUBLIC_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="alisamguesthouse.com"
