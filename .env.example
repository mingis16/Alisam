# ── Copy to .env.local for development. NEVER commit the real .env.local. ──
# Rule #3: all secrets stay server-side; only NEXT_PUBLIC_* values reach the browser bundle.

# --- Database (Distributed PostgreSQL — Supabase / AWS Aurora) ---
DATABASE_URL="postgresql://user:password@primary-writer.cluster.internal:5432/standard_guest_house?sslmode=require"
DATABASE_URL_REPLICA="postgresql://user:password@read-replica.cluster.internal:5432/standard_guest_house?sslmode=require"

# --- Redis cluster (availability cache + distributed locks + rate limiting) ---
REDIS_URL="rediss://default:password@redis-cluster.internal:6379"

# --- App ---
NEXT_PUBLIC_SITE_URL="https://standardguesthousefreetown.com"
NEXT_PUBLIC_MAPS_EMBED_SRC="https://www.google.com/maps?q=College+Road,+Freetown,+Sierra+Leone&output=embed"

# --- Spam protection (Rule #18) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x0000000000000000000000AA"
TURNSTILE_SECRET_KEY="0x0000000000000000000000000000000AA"

# --- Analytics (Rule #19) ---
NEXT_PUBLIC_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="standardguesthousefreetown.com"

# --- Payments (placeholders — see src/lib/payments.ts) ---
ORANGE_MONEY_API_KEY=""
ORANGE_MONEY_MERCHANT_ID=""
AFRICELL_MONEY_API_KEY=""
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# --- Email (booking + contact confirmations) ---
RESEND_API_KEY=""
NOTIFICATIONS_EMAIL="reservations@standardguesthousefreetown.com"

# --- WAF / rate limiting ---
RATE_LIMIT_BOOKING_PER_MINUTE="5"
RATE_LIMIT_CONTACT_PER_MINUTE="10"
