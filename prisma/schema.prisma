// Standard Guest House — data model.
//
// Deployment target: distributed PostgreSQL (Supabase or AWS Aurora
// PostgreSQL-Compatible) with a writer endpoint (DATABASE_URL) and one or
// more read replicas (DATABASE_URL_REPLICA) fronted by a connection pooler
// (PgBouncer / RDS Proxy). See src/lib/db.ts for the read/write routing.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RoomType {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String
  basePriceUsd Decimal  @db.Decimal(10, 2)
  basePriceSll Decimal  @db.Decimal(14, 2)
  maxGuests    Int
  totalUnits   Int // how many physical rooms of this type exist
  amenities    String[] // e.g. ["AC", "TV", "Desk", "En-suite", "Mosquito Net"]
  images       String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rooms    Room[]
  bookings Booking[]

  @@index([slug])
}

model Room {
  id         String   @id @default(cuid())
  roomNumber String   @unique
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  roomTypeId String
  floor      Int      @default(1)
  isActive   Boolean  @default(true)

  bookings Booking[]

  @@index([roomTypeId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentMethod {
  ORANGE_MONEY
  AFRICELL_MONEY
  CARD
  CASH_ON_ARRIVAL
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
  FAILED
}

model Guest {
  id        String    @id @default(cuid())
  fullName  String
  email     String
  phone     String
  country   String?
  createdAt DateTime  @default(now())
  bookings  Booking[]

  @@index([email])
}

// A confirmed Booking reserves one physical Room for a date range.
// Concurrency safety for the [roomId, checkIn, checkOut) interval is enforced
// two ways:
//   1. Application layer: a short-lived Redis lock (see src/lib/redis.ts)
//      serializes concurrent booking attempts for the same room+date window
//      before the DB write, avoiding double-booking under high write load.
//   2. Database layer (belt & suspenders): run this migration once against
//      Postgres to add a GiST exclusion constraint — Prisma cannot express
//      this natively, so it lives in prisma/migrations/*_add_room_exclusion/
//      migration.sql:
//        CREATE EXTENSION IF NOT EXISTS btree_gist;
//        ALTER TABLE "Booking" ADD CONSTRAINT no_overlapping_bookings
//          EXCLUDE USING gist (
//            "roomId" WITH =,
//            daterange("checkIn", "checkOut") WITH &&
//          ) WHERE (status IN ('PENDING', 'CONFIRMED'));
model Booking {
  id            String        @id @default(cuid())
  confirmationCode String     @unique

  guest   Guest  @relation(fields: [guestId], references: [id])
  guestId String

  room   Room   @relation(fields: [roomId], references: [id])
  roomId String

  roomType   RoomType @relation(fields: [roomTypeId], references: [id])
  roomTypeId String

  checkIn  DateTime @db.Date
  checkOut DateTime @db.Date
  guests   Int

  status        BookingStatus @default(PENDING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(UNPAID)

  totalUsd Decimal @db.Decimal(10, 2)
  totalSll Decimal @db.Decimal(14, 2)
  currency String  @default("USD")

  specialRequests String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, checkIn, checkOut])
  @@index([guestId])
  @@index([status])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled, createdAt])
}
